var TOTAL = QUESTIONS.length;
var state = { idx:0, order:[], selected:[], locked:false, answers:[] };

function $(id){ return document.getElementById(id); }
function show(screenId){
  var list = document.querySelectorAll(".screen");
  for(var i=0;i<list.length;i++) list[i].classList.remove("active");
  $(screenId).classList.add("active");
  window.scrollTo({top:0,behavior:"smooth"});
}
function arraysEqual(a,b){
  if(a.length!==b.length) return false;
  var sa=a.slice().sort(function(x,y){return x-y;});
  var sb=b.slice().sort(function(x,y){return x-y;});
  for(var i=0;i<sa.length;i++) if(sa[i]!==sb[i]) return false;
  return true;
}
function shuffled(n){
  var a=[]; for(var i=0;i<n;i++) a.push(i);
  for(var j=a.length-1;j>0;j--){ var k=Math.floor(Math.random()*(j+1)); var t=a[j]; a[j]=a[k]; a[k]=t; }
  return a;
}
var ICON_OK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
var ICON_BAD = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>';

function renderQuestion(){
  var q = QUESTIONS[state.idx];
  state.selected = [];
  state.locked = false;
  state.order = shuffled(q.opts.length);

  $("q-count").textContent = "Вопрос " + (state.idx+1) + " из " + TOTAL;
  $("q-topic").textContent = q.topic;
  $("q-bar").style.width = ((state.idx / TOTAL) * 100) + "%";
  $("q-text").textContent = q.q;
  $("q-multi").classList.toggle("hidden", !q.multi);

  var wrap = $("q-opts");
  wrap.innerHTML = "";
  for(var k=0;k<state.order.length;k++){
    (function(k){
      var original = state.order[k];
      var el = document.createElement("div");
      el.className = "opt";
      el.setAttribute("role", q.multi ? "checkbox":"radio");
      el.setAttribute("tabindex","0");
      el.setAttribute("aria-checked","false");
      el.innerHTML = '<span class="mark">'+LETTERS[k]+'</span><span class="txt">'+q.opts[original]+'</span><span class="res-ic"></span>';
      el.addEventListener("click", function(){ toggleOption(k); });
      el.addEventListener("keydown", function(ev){
        if(ev.key===" "||ev.key==="Enter"){ ev.preventDefault(); toggleOption(k); }
      });
      wrap.appendChild(el);
    })(k);
  }
  $("q-feedback").classList.add("hidden");
  $("btn-answer").classList.remove("hidden");
  $("btn-answer").disabled = true;
  $("btn-next").classList.add("hidden");
  $("btn-next").textContent = (state.idx === TOTAL-1) ? "Показать результат" : "Следующий вопрос";
}

function toggleOption(k){
  if(state.locked) return;
  var q = QUESTIONS[state.idx];
  var pos = state.selected.indexOf(k);
  if(q.multi){
    if(pos===-1) state.selected.push(k); else state.selected.splice(pos,1);
  } else {
    state.selected = (pos===-1) ? [k] : [];
  }
  var opts = $("q-opts").children;
  for(var j=0;j<opts.length;j++){
    var sel = state.selected.indexOf(j)!==-1;
    opts[j].classList.toggle("selected", sel);
    opts[j].setAttribute("aria-checked", sel ? "true":"false");
  }
  $("btn-answer").disabled = state.selected.length===0;
}

function submitAnswer(){
  if(state.locked || state.selected.length===0) return;
  state.locked = true;
  var q = QUESTIONS[state.idx];

  var selOriginal = state.selected.map(function(k){ return state.order[k]; });
  var isCorrect = arraysEqual(selOriginal, q.correct);

  var opts = $("q-opts").children;
  var rightLetters = [];
  var rightPieces = [];
  var yourPieces = [];
  var sortedSel = state.selected.slice().sort(function(a,b){return a-b;});
  for(var k=0;k<opts.length;k++){
    var original = state.order[k];
    opts[k].classList.add("locked");
    opts[k].classList.remove("selected");
    opts[k].setAttribute("tabindex","-1");
    var isRight = q.correct.indexOf(original)!==-1;
    var wasPicked = state.selected.indexOf(k)!==-1;
    var icHost = opts[k].querySelector(".res-ic");
    if(isRight){
      opts[k].classList.add("reveal-ok");
      icHost.innerHTML = ICON_OK; icHost.style.color = "var(--ok)";
      rightLetters.push(LETTERS[k]);
      rightPieces.push(LETTERS[k]+") "+q.opts[original]);
    } else if(wasPicked){
      opts[k].classList.add("reveal-bad");
      icHost.innerHTML = ICON_BAD; icHost.style.color = "var(--err)";
    }
  }
  rightLetters.sort();
  for(var s=0;s<sortedSel.length;s++){
    var kk = sortedSel[s];
    yourPieces.push(LETTERS[kk]+") "+q.opts[state.order[kk]]);
  }

  state.answers[state.idx] = {
    correct: isCorrect,
    yourText: yourPieces.join("; "),
    rightText: rightPieces.sort().join("; ")
  };

  var v = $("q-verdict");
  if(isCorrect){
    v.className = "verdict good";
    v.innerHTML = ICON_OK + "<span>Правильно</span>";
  } else {
    v.className = "verdict bad";
    var label = q.multi ? "Неправильно. Правильные варианты: " : "Неправильно. Правильный ответ: ";
    v.innerHTML = ICON_BAD + "<span>"+label+rightLetters.join(", ")+"</span>";
  }
  $("q-explain").textContent = q.explain;
  $("q-basis").textContent = q.basis;
  $("q-feedback").classList.remove("hidden");
  $("btn-answer").classList.add("hidden");
  $("btn-next").classList.remove("hidden");
  $("q-bar").style.width = (((state.idx+1) / TOTAL) * 100) + "%";
}

function nextQuestion(){
  if(state.idx < TOTAL-1){ state.idx++; renderQuestion(); }
  else { showResult(); }
}

function showResult(){
  var ok = 0;
  for(var i=0;i<state.answers.length;i++){ if(state.answers[i] && state.answers[i].correct) ok++; }
  var err = TOTAL - ok;
  var exact = (ok/TOTAL)*100;
  var pct = Math.round(exact);
  $("res-percent").textContent = pct + "%";
  $("res-fraction").textContent = ok + " из " + TOTAL;
  $("res-ok").textContent = ok;
  $("res-err").textContent = err;

  var grade, sub, ringColor;
  if(exact>=90){ grade="Отлично"; sub="Высокий уровень знаний по оказанию первой помощи."; ringColor="#5fd39a"; }
  else if(exact>=80){ grade="Зачёт"; sub="Основные требования усвоены."; ringColor="#5fd39a"; }
  else if(exact>=70){ grade="Удовлетворительно"; sub="Рекомендуется повторить отдельные темы."; ringColor="#f2c14e"; }
  else { grade="Не пройден"; sub="Рекомендуется повторно изучить Порядок оказания первой помощи."; ringColor="#ef8a7f"; }
  $("res-grade").textContent = grade;
  $("res-grade-sub").textContent = sub;

  var ring = $("ring-fg");
  ring.setAttribute("stroke", ringColor);
  var circ = 490;
  ring.style.transition = "none";
  ring.style.strokeDashoffset = circ;
  show("screen-result");
  setTimeout(function(){
    ring.style.transition = "stroke-dashoffset 1s ease";
    ring.style.strokeDashoffset = circ - (circ * pct/100);
  }, 120);
  $("btn-review").textContent = (err>0) ? "Разобрать ошибки" : "Показать разбор";
}

function showReview(){
  var list = $("rev-list");
  list.innerHTML = "";
  var wrong = [];
  for(var i=0;i<QUESTIONS.length;i++){ if(state.answers[i] && !state.answers[i].correct) wrong.push(i); }
  $("rev-sub").textContent = wrong.length===0 ? "Ошибок нет" : (wrong.length===1 ? "1 вопрос с ошибкой" : wrong.length + " вопрос(ов) с ошибками");
  if(wrong.length===0){
    list.innerHTML = '<div class="rev-empty">Отличный результат! Все вопросы решены правильно.</div>';
  }
  for(var w=0;w<wrong.length;w++){
    var qi = wrong[w];
    var q = QUESTIONS[qi];
    var ans = state.answers[qi];
    var item = document.createElement("div");
    item.className = "rev-item";
    item.innerHTML =
      '<p class="rq">'+(qi+1)+'. '+q.q+'</p>'+
      '<div class="rev-line"><span class="tag your">Ваш ответ</span><span>'+(ans.yourText||"—")+'</span></div>'+
      '<div class="rev-line"><span class="tag right">Верно</span><span>'+ans.rightText+'</span></div>'+
      '<div class="explain"><p class="lbl">Почему и как действовать</p><p>'+q.explain+'</p></div>'+
      '<p class="basis"><span class="lbl">Основание</span>'+q.basis+'</p>';
    list.appendChild(item);
  }
  show("screen-review");
}

function restart(){
  state = { idx:0, order:[], selected:[], locked:false, answers:[] };
  var ring = $("ring-fg");
  ring.style.transition = "none";
  ring.style.strokeDashoffset = 490;
  show("screen-start");
}

$("btn-start").addEventListener("click", function(){ renderQuestion(); show("screen-quiz"); });
$("btn-answer").addEventListener("click", submitAnswer);
$("btn-next").addEventListener("click", nextQuestion);
$("btn-review").addEventListener("click", showReview);
$("btn-restart").addEventListener("click", restart);
$("btn-restart2").addEventListener("click", restart);
$("btn-back-result").addEventListener("click", function(){ show("screen-result"); });
</script>

