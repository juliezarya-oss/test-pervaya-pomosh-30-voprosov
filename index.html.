<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Тест: оказание первой помощи пострадавшим</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=PT+Sans:wght@400;700&display=swap">
<style>
  :root{
    --ground:#eef4f4;--surface:#ffffff;--navy:#0e4a55;--navy-deep:#093640;
    --blue:#1f8a99;--blue-soft:#e4f3f4;--blue-border:#b6dfe3;
    --red:#c8362f;--red-soft:#fdeceb;--red-border:#f2bcb7;
    --ink:#122127;--muted:#566670;--line:#e0eaeb;
    --ok:#157a4b;--ok-bg:#e7f6ee;--ok-border:#a9dcc0;
    --err:#c0392b;--err-bg:#fcecea;--err-border:#f0bcb5;
    --radius:16px;--radius-sm:12px;
    --shadow:0 10px 30px -12px rgba(14,74,85,.30);--shadow-sm:0 2px 8px -3px rgba(14,74,85,.22);
    color-scheme:light;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--ground);color:var(--ink);font-family:"PT Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;font-size:17px;line-height:1.55;-webkit-font-smoothing:antialiased}
  h1,h2,h3{font-family:"Manrope","PT Sans",sans-serif;text-wrap:balance}
  .wrap{max-width:680px;margin:0 auto;padding:24px 18px 64px;min-height:100%}
  .card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
  .screen{display:none}
  .screen.active{display:block;animation:fade .32s ease both}
  @keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  @media (prefers-reduced-motion:reduce){.screen.active{animation:none} *{transition:none!important}}

  .start-head{background:linear-gradient(160deg,var(--navy) 0%,var(--navy-deep) 100%);color:#fff;padding:38px 30px 32px;text-align:center;position:relative}
  .start-head::after{content:"";position:absolute;top:18px;right:20px;width:34px;height:34px;background:
    linear-gradient(#fff,#fff) center/12px 34px no-repeat,
    linear-gradient(#fff,#fff) center/34px 12px no-repeat;
    -webkit-mask:radial-gradient(circle,#000 99%,transparent);opacity:.14;border-radius:8px}
  .eyebrow{font-family:"Manrope",sans-serif;text-transform:uppercase;letter-spacing:.13em;font-size:12px;font-weight:700;color:#8fd0d8;margin:0 0 12px}
  .start-head h1{margin:0 0 8px;font-size:27px;font-weight:800;letter-spacing:-.01em}
  .start-head .sub{margin:0 0 3px;font-size:16px;color:#cbe8ec;font-weight:400;line-height:1.4}
  .start-head .sub2{margin:0;font-size:13.5px;color:#8fd0d8;font-weight:400}
  .icons{display:flex;justify-content:center;gap:12px;margin:22px 0 4px;flex-wrap:wrap}
  .icons span{width:50px;height:50px;display:grid;place-items:center;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.18);border-radius:14px}
  .icons svg{width:27px;height:27px;stroke:#dcf0f2;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .start-body{padding:26px 30px 30px}
  .lead{margin:0 0 20px;color:#2c4f57;font-size:15.5px}
  .meta-row{display:flex;gap:12px;flex-wrap:wrap;margin:0 0 20px}
  .chip{flex:1 1 130px;background:var(--blue-soft);border:1px solid var(--blue-border);border-radius:var(--radius-sm);padding:14px 16px;text-align:center}
  .chip b{display:block;font-family:"Manrope",sans-serif;font-size:22px;color:var(--navy);line-height:1.1}
  .chip small{color:var(--muted);font-size:13px}
  .note{background:var(--blue-soft);border:1px solid var(--blue-border);border-radius:var(--radius-sm);padding:14px 16px;font-size:14px;color:#2c4f57;margin:0 0 24px}
  .note b{color:var(--navy)}

  .btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;width:100%;font-family:"Manrope",sans-serif;font-weight:700;font-size:18px;padding:16px 22px;border-radius:14px;border:none;cursor:pointer;transition:background .18s,transform .06s,box-shadow .18s}
  .btn:active{transform:translateY(1px)}
  .btn-primary{background:var(--navy);color:#fff;box-shadow:var(--shadow-sm)}
  .btn-primary:hover{background:var(--navy-deep)}
  .btn-primary:disabled{background:#adc3c6;color:#eef4f4;cursor:not-allowed;box-shadow:none}
  .btn-ghost{background:var(--surface);color:var(--navy);border:1.6px solid var(--blue-border)}
  .btn-ghost:hover{background:var(--blue-soft)}
  .btn:focus-visible{outline:3px solid #74c2cd;outline-offset:2px}

  .q-top{padding:18px 24px 16px;border-bottom:1px solid var(--line);background:var(--surface)}
  .q-top-row{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:10px;gap:10px}
  .q-count{font-family:"Manrope",sans-serif;font-weight:700;color:var(--navy);font-size:15px;white-space:nowrap}
  .q-topic{color:var(--muted);font-size:12.5px;text-align:right}
  .bar{height:8px;background:var(--ground);border-radius:99px;overflow:hidden}
  .bar>i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--blue),var(--navy));border-radius:99px;transition:width .4s ease}

  .q-body{padding:24px 24px 26px}
  .q-multi-tag{display:inline-block;background:var(--blue-soft);color:var(--navy);border:1px solid var(--blue-border);font-family:"Manrope",sans-serif;font-weight:700;font-size:12px;letter-spacing:.03em;padding:4px 11px;border-radius:99px;margin-bottom:12px}
  .q-text{font-size:19.5px;font-weight:700;font-family:"Manrope",sans-serif;line-height:1.42;margin:0 0 20px}
  .opts{display:flex;flex-direction:column;gap:11px;margin-bottom:22px}
  .opt{display:flex;align-items:flex-start;gap:13px;border:1.6px solid var(--line);border-radius:var(--radius-sm);padding:14px 16px;cursor:pointer;background:var(--surface);transition:border-color .15s,background .15s}
  .opt:hover{border-color:var(--blue-border);background:#f6fbfb}
  .opt.selected{border-color:var(--blue);background:var(--blue-soft)}
  .opt .mark{flex:0 0 auto;width:30px;height:30px;border-radius:8px;border:1.6px solid var(--blue-border);display:grid;place-items:center;font-family:"Manrope",sans-serif;font-weight:700;color:var(--navy);font-size:15px;background:var(--surface)}
  .opt.selected .mark{background:var(--blue);color:#fff;border-color:var(--blue)}
  .opt .txt{padding-top:3px}
  .opt.locked{cursor:default}
  .opt.reveal-ok{border-color:var(--ok-border);background:var(--ok-bg)}
  .opt.reveal-ok .mark{background:var(--ok);border-color:var(--ok);color:#fff}
  .opt.reveal-bad{border-color:var(--err-border);background:var(--err-bg)}
  .opt.reveal-bad .mark{background:var(--err);border-color:var(--err);color:#fff}
  .opt .res-ic{margin-left:auto;flex:0 0 auto;align-self:center}
  .opt .res-ic svg{width:22px;height:22px}

  .verdict{display:flex;align-items:center;gap:11px;font-family:"Manrope",sans-serif;font-weight:800;font-size:18px;padding:14px 16px;border-radius:var(--radius-sm);margin-bottom:14px;line-height:1.3}
  .verdict svg{width:26px;height:26px;flex:0 0 auto}
  .verdict.good{background:var(--ok-bg);color:var(--ok);border:1px solid var(--ok-border)}
  .verdict.bad{background:var(--err-bg);color:var(--err);border:1px solid var(--err-border)}
  .explain{background:var(--blue-soft);border:1px solid var(--blue-border);border-radius:var(--radius-sm);padding:15px 17px;margin-bottom:14px}
  .explain .lbl{font-family:"Manrope",sans-serif;font-weight:700;color:var(--navy);font-size:13px;text-transform:uppercase;letter-spacing:.05em;margin:0 0 5px}
  .explain p{margin:0;font-size:15.5px;color:#274850}
  .basis{font-size:13.5px;color:var(--muted);border-left:3px solid var(--blue-border);padding:2px 0 2px 12px;margin-bottom:20px}
  .basis .lbl{display:block;font-family:"Manrope",sans-serif;font-weight:700;color:var(--navy);font-size:11.5px;text-transform:uppercase;letter-spacing:.05em;margin-bottom:2px}
  .hidden{display:none}

  .result-head{text-align:center;padding:38px 30px 30px;color:#fff;background:linear-gradient(160deg,var(--navy) 0%,var(--navy-deep) 100%)}
  .ring-wrap{position:relative;width:180px;height:180px;margin:6px auto 18px}
  .ring-wrap svg{transform:rotate(-90deg)}
  .ring-num{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
  .ring-num b{font-family:"Manrope",sans-serif;font-size:44px;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}
  .ring-num small{color:#cbe8ec;font-size:14px;margin-top:3px}
  .grade{font-family:"Manrope",sans-serif;font-weight:800;font-size:22px;margin:0 0 4px}
  .grade-sub{margin:0;color:#cbe8ec;font-size:15px;max-width:92%;margin-inline:auto}
  .score-split{display:flex;gap:12px;padding:22px 24px 6px}
  .score-box{flex:1;border-radius:var(--radius-sm);padding:16px;text-align:center;border:1px solid}
  .score-box.ok{background:var(--ok-bg);border-color:var(--ok-border)}
  .score-box.er{background:var(--err-bg);border-color:var(--err-border)}
  .score-box b{display:block;font-family:"Manrope",sans-serif;font-size:30px;line-height:1;font-variant-numeric:tabular-nums}
  .score-box.ok b{color:var(--ok)}
  .score-box.er b{color:var(--err)}
  .score-box small{font-size:13.5px;color:var(--muted)}
  .result-actions{display:flex;flex-direction:column;gap:11px;padding:22px 24px 26px}
  .mini-note{margin:2px 2px 6px;font-size:12.5px;color:var(--muted);line-height:1.45;text-align:center}

  .review-head{padding:22px 24px 8px}
  .review-head h2{margin:0 0 4px;font-size:22px;color:var(--navy)}
  .review-head p{margin:0;color:var(--muted);font-size:14.5px}
  .rev-list{padding:12px 20px 20px;display:flex;flex-direction:column;gap:16px}
  .rev-item{border:1px solid var(--line);border-radius:var(--radius-sm);padding:16px 17px}
  .rev-item .rq{font-family:"Manrope",sans-serif;font-weight:700;font-size:16px;line-height:1.4;margin:0 0 12px}
  .rev-line{display:flex;gap:9px;font-size:15px;margin-bottom:8px;align-items:flex-start}
  .rev-line .tag{flex:0 0 auto;font-family:"Manrope",sans-serif;font-weight:700;font-size:12px;padding:2px 9px;border-radius:6px;margin-top:2px}
  .tag.your{background:var(--err-bg);color:var(--err)}
  .tag.right{background:var(--ok-bg);color:var(--ok)}
  .rev-item .explain{margin:12px 0 10px}
  .rev-item .basis{margin-bottom:2px}
  .rev-empty{padding:30px 24px 34px;text-align:center;color:var(--ok);font-family:"Manrope",sans-serif;font-weight:700}
  .footer-note{text-align:center;font-size:12.5px;color:#7f929a;margin:18px 6px 0;line-height:1.5}
</style>

</head>
<body>
<div class="wrap">
  <div class="card">

    <!-- START -->
    <section id="screen-start" class="screen active">
      <div class="start-head">
        <p class="eyebrow">Проверка знаний · Первая помощь</p>
        <h1>Оказание первой помощи пострадавшим</h1>
        <p class="sub">Учебная самопроверка для работников</p>
        <p class="sub2">По действующему законодательству РФ (2026 г.)</p>
        <div class="icons" aria-hidden="true">
          <span title="Первая помощь"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M12 9.5v6M9 12.5h6"/><path d="M8.5 6V4.5A1.5 1.5 0 0 1 10 3h4a1.5 1.5 0 0 1 1.5 1.5V6"/></svg></span>
          <span title="Сердечно-лёгочная реанимация"><svg viewBox="0 0 24 24"><path d="M20.5 9.5c0-2.5-2-4.5-4.4-4.5-1.6 0-3 .9-3.6 2.2C11.9 5.9 10.5 5 8.9 5 6.5 5 4.5 7 4.5 9.5c0 .5.1 1 .2 1.4h4l1.3-2.4 2.2 5 1.4-2.6h4.5c.1-.4.2-.9.2-1.4z"/><path d="M4.9 11c1.3 3 4.6 5.5 7.1 7.4 2.5-1.9 5.8-4.4 7.1-7.4"/></svg></span>
          <span title="Остановка кровотечения"><svg viewBox="0 0 24 24"><path d="M12 3.5s6 6.4 6 10.5a6 6 0 0 1-12 0c0-4.1 6-10.5 6-10.5z"/></svg></span>
          <span title="Вызов скорой помощи"><svg viewBox="0 0 24 24"><path d="M5 4h3l1.5 4.5-2 1.5a12 12 0 0 0 6 6l1.5-2 4.5 1.5V19a2 2 0 0 1-2 2A16 16 0 0 1 4 6a2 2 0 0 1 1-2z"/></svg></span>
          <span title="Перевязка"><svg viewBox="0 0 24 24"><rect x="3.5" y="8" width="17" height="8" rx="4" transform="rotate(45 12 12)"/><path d="M9.5 9.5l5 5M12 8.5l3.5 3.5M8.5 12l3.5 3.5"/></svg></span>
          <span title="Безопасность"><svg viewBox="0 0 24 24"><path d="M12 3.5 21 19H3z"/><line x1="12" y1="10" x2="12" y2="14"/><line x1="12" y1="16.5" x2="12" y2="16.6"/></svg></span>
        </div>
      </div>
      <div class="start-body">
        <p class="lead">Проверьте знание порядка, перечня состояний и последовательности мероприятий по оказанию первой помощи — в объёме, установленном действующим законодательством для лиц без медицинского образования.</p>
        <div class="meta-row">
          <div class="chip"><b>30</b><small>вопросов</small></div>
          <div class="chip"><b>4</b><small>варианта ответа</small></div>
          <div class="chip"><b>80%</b><small>порог зачёта</small></div>
        </div>
        <p class="note"><b>Учебная самопроверка.</b> Вопросы основаны исключительно на действующих нормативных актах: Приказ Минздрава России от 03.05.2024 № 220н «Об утверждении Порядка оказания первой помощи» (действует с 01.09.2024), ст. 31 Федерального закона от 21.11.2011 № 323-ФЗ (в ред. Федерального закона № 135-ФЗ), Постановление Правительства РФ от 24.12.2021 № 2464 (в ред. Постановления Правительства РФ № 805, действует с 31.08.2026) — в части обучения по оказанию первой помощи. Варианты ответов перемешиваются при каждом прохождении. Тест не заменяет практическое обучение с использованием тренажёров.</p>
        <button class="btn btn-primary" id="btn-start">Начать тест</button>
      </div>
    </section>

    <!-- QUIZ -->
    <section id="screen-quiz" class="screen">
      <div class="q-top">
        <div class="q-top-row">
          <span class="q-count" id="q-count">Вопрос 1 из 30</span>
          <span class="q-topic" id="q-topic"></span>
        </div>
        <div class="bar"><i id="q-bar"></i></div>
      </div>
      <div class="q-body">
        <div class="q-multi-tag hidden" id="q-multi">Выберите все правильные варианты</div>
        <h2 class="q-text" id="q-text"></h2>
        <div class="opts" id="q-opts"></div>
        <div id="q-feedback" class="hidden">
          <div class="verdict" id="q-verdict"></div>
          <div class="explain">
            <p class="lbl">Пояснение</p>
            <p id="q-explain"></p>
          </div>
          <p class="basis"><span class="lbl">Основание</span><span id="q-basis"></span></p>
        </div>
        <button class="btn btn-primary" id="btn-answer" disabled>Ответить</button>
        <button class="btn btn-primary hidden" id="btn-next">Следующий вопрос</button>
      </div>
    </section>

    <!-- RESULT -->
    <section id="screen-result" class="screen">
      <div class="result-head">
        <div class="ring-wrap">
          <svg width="180" height="180" viewBox="0 0 180 180">
            <circle cx="90" cy="90" r="78" fill="none" stroke="rgba(255,255,255,.16)" stroke-width="14"/>
            <circle id="ring-fg" cx="90" cy="90" r="78" fill="none" stroke="#5fd39a" stroke-width="14" stroke-linecap="round" stroke-dasharray="490" stroke-dashoffset="490"/>
          </svg>
          <div class="ring-num">
            <b id="res-percent">0%</b>
            <small id="res-fraction">0 из 30</small>
          </div>
        </div>
        <p class="grade" id="res-grade"></p>
        <p class="grade-sub" id="res-grade-sub"></p>
      </div>
      <div class="score-split">
        <div class="score-box ok"><b id="res-ok">0</b><small>Правильных ответов</small></div>
        <div class="score-box er"><b id="res-err">0</b><small>Ошибок</small></div>
      </div>
      <div class="result-actions">
        <p class="mini-note">Учебная самопроверка. Результат не является официальным протоколом проверки знаний и не подтверждает прохождение обязательного обучения по оказанию первой помощи.</p>
        <button class="btn btn-ghost" id="btn-review">Разобрать ошибки</button>
        <button class="btn btn-primary" id="btn-restart">Пройти тест ещё раз</button>
      </div>
    </section>

    <!-- REVIEW -->
    <section id="screen-review" class="screen">
      <div class="review-head">
        <h2>Разбор ошибок</h2>
        <p id="rev-sub"></p>
      </div>
      <div class="rev-list" id="rev-list"></div>
      <div class="result-actions">
        <button class="btn btn-ghost" id="btn-back-result">Назад к результату</button>
        <button class="btn btn-primary" id="btn-restart2">Пройти тест ещё раз</button>
      </div>
    </section>

  </div>
  <p class="footer-note">Материал носит справочный характер и предназначен для самостоятельной проверки знаний. При оказании первой помощи действуйте в объёме своей подготовки и в соответствии с действующим Порядком оказания первой помощи (Приказ Минздрава России № 220н).</p>
</div>

<script>
"use strict";
var LETTERS = ["А","Б","В","Г"];

// Каноническое хранение: opts + correct (индексы). Порядок вариантов перемешивается при показе.
var QUESTIONS = [
  {
    topic:"Правовые основы",
    multi:false,
    q:"Что такое первая помощь в соответствии с Федеральным законом № 323-ФЗ?",
    opts:[
      "Комплекс мероприятий, направленных на сохранение и поддержание жизни и здоровья пострадавших, до оказания медицинской помощи",
      "Вид медицинской помощи, которую оказывает только врач",
      "Лечение заболеваний и травм в медицинской организации",
      "Выдача пострадавшему лекарственных препаратов по назначению врача"
    ],
    correct:[0],
    explain:"Первая помощь — это комплекс мероприятий, направленных на сохранение и поддержание жизни и здоровья пострадавших, оказываемых до оказания медицинской помощи. Это не медицинская помощь и не лечение: она оказывается на месте происшествия в объёме установленного Порядка.",
    basis:"ст. 31 Федерального закона от 21.11.2011 № 323-ФЗ (в ред. Федерального закона от 14.04.2023 № 135-ФЗ, действует с 01.09.2024)"
  },
  {
    topic:"Кто оказывает",
    multi:false,
    q:"Может ли работник, не входящий в перечень лиц, обязанных оказывать первую помощь, оказывать её пострадавшему?",
    opts:[
      "Да, он вправе оказывать первую помощь при наличии соответствующей подготовки и (или) навыков",
      "Нет, первую помощь имеют право оказывать только медицинские работники",
      "Да, но только с письменного разрешения руководителя",
      "Нет, это запрещено законом для лиц без медицинского образования"
    ],
    correct:[0],
    explain:"Закон закрепляет перечень лиц, обязанных оказывать первую помощь (сотрудники ОВД, спасатели, пожарные, военнослужащие, водители и др.). Остальные граждане вправе оказывать первую помощь при наличии соответствующей подготовки и (или) навыков. Это право, а не обязанность.",
    basis:"ст. 31 Федерального закона от 21.11.2011 № 323-ФЗ (в ред. № 135-ФЗ)"
  },
  {
